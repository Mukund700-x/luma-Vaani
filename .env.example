# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=LumaVaani
APP_VERSION=0.1.0
DEBUG=true

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lumadb
POSTGRES_USER=lumauser
POSTGRES_PASSWORD=lumasecret
DATABASE_URL=postgresql+asyncpg://lumauser:lumasecret@localhost:5432/lumadb

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redissecret
REDIS_URL=redis://:redissecret@localhost:6379/0

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── AI Gateway (Gemini — Phase 4) ───────────────────────────────────────────
# Get your API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=1024

# Conversation safety and limits
AI_SAFETY_ENABLED=true
AI_MAX_TOOL_ITERATIONS=6
AI_MAX_CONVERSATION_TURNS=50
AI_TOOL_TIMEOUT_SECONDS=10.0

# Optional: other providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Notifications (stubs — not active until Phase 6) ────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
